<?xml version="1.0" encoding="utf-8"?>
<!-- هیچ داده‌ای (کلیپ‌بورد، کلمه‌ها، میان‌برها) به بکاپ ابری یا انتقال دستگاه نمی‌رود؛ بکاپ فقط با فایل JSON خود کاربر -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
